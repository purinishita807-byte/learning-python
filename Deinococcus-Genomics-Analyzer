        "import numpy as np\n",
        "\n",
        "class DNARepairAnalyzer:\n",
        "    def __init__(self, sequence_name, sequence):\n",
        "        self.name = sequence_name\n",
        "        self.sequence = sequence.upper()\n",
        "\n",
        "    def calculate_gc_content(self):\n",
        "        g_count = self.sequence.count('G')\n",
        "        c_count = self.sequence.count('C')\n",
        "        total_length = len(self.sequence)\n",
        "        gc_percentage = ((g_count + c_count) / total_length) * 100\n",
        "        return round(gc_percentage, 2)\n",
        "\n",
        "    def find_mutation_hotspots(self):\n",
        "        dna_array = np.array(list(self.sequence))\n",
        "        t_indices = np.where(dna_array == 'T')[0] # [0] to get just the indices array\n",
        "        return t_indices.tolist()\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    print(f\"--- Analyzing Deinococcus radiodurans DNA ---\")\n",
        "\n",
        "    sample_dna = \"ATGGCAAAAGACGACAACAAGAAGAAAGCCCTCGAAACCGCCATCAAGCAGGCCCTTCGTCGCAAGGGCGGCGTGATCGACCTGGAGAACGGCAAGGTCGTCGTCGACGCCGTCGGCAAGGGCGCCACCGTCACCCAGCTCCTCGGCGGCGACGCCAAGCTCACCCGCGCCGAGTTCGAGGTCCTCGGCCGCAAGCTCGGCATC\"\n",
        "\n",
        "    analyzer = DNARepairAnalyzer(\"RecA Gene Segment\", sample_dna)\n",
        "\n",
        "    gc_result = analyzer.calculate_gc_content()\n",
        "    print(f\"GC Content of {analyzer.name}: {gc_result}%\")\n",
        "\n",
        "    t_spots = analyzer.find_mutation_hotspots()\n",
        "    print(f\"Thymine (T) positions (Radiation Target Sites): {t_spots}\")"
      ],
